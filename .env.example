# -------------------------------------------------------------
# 部署环境配置示例 (复制本文件为 .env 并按实际修改)
# -------------------------------------------------------------

# 1. 您的二级域名 (例如: xzm.yourdomain.com 或 line.yourdomain.com)
DOMAIN=line.yourdomain.com

# 2. 宿主机上 Traefik 容器所在的 Docker 外部网络名称 (常见如: traefik-net, web, traefik_default)
TRAEFIK_NETWORK=traefik-net
